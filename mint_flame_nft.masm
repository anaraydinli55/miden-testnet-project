use miden::standards::components::faucets::non_fungible_faucet

@transaction_script
pub proc main
    # 1. Alıcı cüzdan
    push.0x000000000000000000000000000000000086341565987080016e478676445d61

    # 2. Not növü (1 = Public) və Tag (0)
    push.1
    push.0

    # 3. Flame Towers ZK Şəkil Hash-i
    push.0x03297a176cc58f2647876304c35a3146c559cfbb0e5c26592cf88d3d93593919

    # 4. NFT Darxana ID-si
    push.0x000000000000000000000000000000000055830500881218516d141fcb18b2d2

    # 5. Prosedur çağırışı
    call.non_fungible_faucet::mint_and_send
    dropw dropw dropw dropw
end